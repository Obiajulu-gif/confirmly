{
  "//": "Confirmly native WhatsApp ordering Flow. Do NOT edit the generated flows/order-flow.json by hand — edit this template and run `npm run flow:build`, which injects Base64 images in place of the __ASSET_*__ tokens. Flow JSON 7.1 (latest, verified against Meta's changelog) with data_api_version 3.0. Every screen after START is data-driven through the data_exchange endpoint at app/api/whatsapp/flow/route.ts, which resolves every store, product, price and stock value from PostgreSQL and never trusts a value echoed by the client.",
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "START": [
      "ONBOARDING",
      "SEARCH"
    ],
    "ONBOARDING": [
      "SEARCH"
    ],
    "SEARCH": [
      "SHOP"
    ],
    "SHOP": [
      "DELIVERY"
    ],
    "DELIVERY": [
      "REVIEW"
    ],
    "REVIEW": [
      "PAYMENT"
    ],
    "PAYMENT": []
  },
  "screens": [
    {
      "id": "ONBOARDING",
      "title": "Set up your account",
      "terminal": false,
      "data": {
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Welcome to Confirmly 👋"
          },
          {
            "type": "TextBody",
            "text": "Tell us a little about yourself and you're ready to order."
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              {
                "type": "TextCaption",
                "text": "${data.error_message}"
              }
            ]
          },
          {
            "type": "TextInput",
            "name": "name",
            "label": "Your name",
            "input-type": "text",
            "required": true
          },
          {
            "type": "TextInput",
            "name": "email",
            "label": "Email address",
            "input-type": "email",
            "required": true
          },
          {
            "type": "TextInput",
            "name": "referral",
            "label": "Referral code (optional)",
            "input-type": "text",
            "required": false,
            "helper-text": "Already filled in if you used a friend's link."
          },
          {
            "type": "Footer",
            "label": "Get started",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "name": "${form.name}",
                "email": "${form.email}",
                "referral": "${form.referral}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "START",
      "title": "Order on WhatsApp",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "__ASSET_BANNER__",
            "height": 200,
            "scale-type": "cover",
            "alt-text": "Confirmly — order from local stores on WhatsApp"
          },
          {
            "type": "TextHeading",
            "text": "What do you want to order?"
          },
          {
            "type": "TextBody",
            "text": "Find a store and check out without leaving WhatsApp. Payments settle securely through Monnify."
          },
          {
            "type": "Footer",
            "label": "Browse stores",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "entry_point": "marketplace"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SEARCH",
      "title": "Choose a store",
      "terminal": false,
      "data": {
        "store_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "main-content": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "metadata": {
                    "type": "string"
                  }
                }
              },
              "start": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string"
                  },
                  "alt-text": {
                    "type": "string"
                  }
                }
              },
              "on-click-action": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "properties": {
                      "store_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "__example__": [
            {
              "id": "store_example",
              "main-content": {
                "title": "Ada Styles",
                "description": "Fashion",
                "metadata": "ADASTYLES"
              },
              "start": {
                "image": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVQImWNgYGBgAAAABQABh6FO1AAAAABJRU5ErkJggg==",
                "alt-text": "Ada Styles logo"
              },
              "on-click-action": {
                "name": "data_exchange",
                "payload": {
                  "store_id": "store_example"
                }
              }
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "NavigationList",
            "name": "store_nav",
            "list-items": "${data.store_items}"
          }
        ]
      }
    },
    {
      "id": "SHOP",
      "title": "Shop",
      "terminal": false,
      "data": {
        "store_name": {
          "type": "string",
          "__example__": "Ada Kitchen"
        },
        "footer_label": {
          "type": "string",
          "__example__": "Continue"
        },
        "show_product": {
          "type": "boolean",
          "__example__": false
        },
        "show_cart": {
          "type": "boolean",
          "__example__": false
        },
        "show_cart_hint": {
          "type": "boolean",
          "__example__": false
        },
        "show_products": {
          "type": "boolean",
          "__example__": true
        },
        "show_product_image": {
          "type": "boolean",
          "__example__": false
        },
        "show_sizes": {
          "type": "boolean",
          "__example__": false
        },
        "show_colours": {
          "type": "boolean",
          "__example__": false
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        },
        "has_cart": {
          "type": "boolean",
          "__example__": false
        },
        "cart_hint": {
          "type": "string",
          "__example__": ""
        },
        "has_products": {
          "type": "boolean",
          "__example__": true
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "alt-text": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "product_example",
              "title": "Fried Rice",
              "description": "Main meals · ₦1,150",
              "image": "",
              "alt-text": "Fried Rice"
            }
          ]
        },
        "product_name": {
          "type": "string",
          "__example__": "Stew"
        },
        "product_price": {
          "type": "string",
          "__example__": "₦820"
        },
        "product_description": {
          "type": "string",
          "__example__": "Rich tomato stew."
        },
        "product_image": {
          "type": "string",
          "__example__": ""
        },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "1"
            },
            {
              "id": "2",
              "title": "2"
            }
          ]
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": []
        },
        "colours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": []
        },
        "cart_lines": {
          "type": "string",
          "__example__": ""
        },
        "cart_total": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.store_name}"
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              {
                "type": "TextCaption",
                "text": "${data.error_message}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_cart_hint}",
            "then": [
              {
                "type": "TextBody",
                "text": "${data.cart_hint}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_products}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "product_pick",
                "label": "Choose a product",
                "required": false,
                "media-size": "regular",
                "data-source": "${data.products}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_product_image}",
            "then": [
              {
                "type": "Image",
                "src": "${data.product_image}",
                "height": 220,
                "scale-type": "cover",
                "alt-text": "${data.product_name}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_product}",
            "then": [
              {
                "type": "TextHeading",
                "text": "${data.product_name}"
              },
              {
                "type": "TextSubheading",
                "text": "${data.product_price}"
              },
              {
                "type": "TextBody",
                "text": "${data.product_description}"
              },
              {
                "type": "Dropdown",
                "name": "quantity",
                "label": "Quantity",
                "required": false,
                "data-source": "${data.quantities}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_sizes}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "size",
                "label": "Size",
                "required": false,
                "data-source": "${data.sizes}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_colours}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "colour",
                "label": "Colour",
                "required": false,
                "data-source": "${data.colours}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_cart}",
            "then": [
              {
                "type": "TextBody",
                "text": "${data.cart_lines}"
              },
              {
                "type": "TextSubheading",
                "text": "${data.cart_total}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "cart_action",
                "label": "What next?",
                "required": true,
                "data-source": [
                  {
                    "id": "continue",
                    "title": "Continue shopping"
                  },
                  {
                    "id": "checkout",
                    "title": "Checkout"
                  },
                  {
                    "id": "remove",
                    "title": "Remove last item"
                  }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "${data.footer_label}",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "product_pick": "${form.product_pick}",
                "quantity": "${form.quantity}",
                "size": "${form.size}",
                "colour": "${form.colour}",
                "cart_action": "${form.cart_action}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DELIVERY",
      "title": "Delivery",
      "terminal": false,
      "data": {
        "has_zones": {
          "type": "boolean",
          "__example__": true
        },
        "has_error": {
          "type": "boolean",
          "__example__": false
        },
        "error_message": {
          "type": "string",
          "__example__": ""
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "zone_example",
              "title": "Lekki",
              "description": "₦1,500 delivery"
            },
            {
              "id": "PICKUP",
              "title": "Store pickup",
              "description": "Free"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Where should we deliver?"
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [
              {
                "type": "TextCaption",
                "text": "${data.error_message}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.has_zones}",
            "then": [
              {
                "type": "Dropdown",
                "name": "delivery_zone",
                "label": "Delivery area",
                "required": true,
                "data-source": "${data.zones}"
              },
              {
                "type": "TextArea",
                "name": "address",
                "label": "Delivery address",
                "helper-text": "House number, street and landmark. Leave blank for store pickup.",
                "required": false
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "delivery_zone": "${form.delivery_zone}",
                "address": "${form.address}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review order",
      "terminal": false,
      "data": {
        "summary": {
          "type": "string",
          "__example__": "2 × Cotton Polo (M, Black)\nDeliver to Lekki\n12 Admiralty Way"
        },
        "total_label": {
          "type": "string",
          "__example__": "Total: ₦25,500"
        },
        "flow_token": {
          "type": "string",
          "__example__": "flow-token-example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Review your order"
          },
          {
            "type": "TextBody",
            "text": "${data.summary}"
          },
          {
            "type": "TextSubheading",
            "text": "${data.total_label}"
          },
          {
            "type": "TextCaption",
            "text": "Tapping Confirm places your order and shows a secure Monnify payment link right here."
          },
          {
            "type": "Footer",
            "label": "Confirm order",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "PAYMENT",
      "title": "Payment",
      "terminal": true,
      "data": {
        "payment_summary": {
          "type": "string",
          "__example__": "Order CFY-7Y7SUEG7 is confirmed.\n\nTotal due: ₦10,000"
        },
        "checkout_url": {
          "type": "string",
          "__example__": "https://sandbox.sdk.monnify.com/checkout/example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Order confirmed ✅"
          },
          {
            "type": "TextBody",
            "text": "${data.payment_summary}"
          },
          {
            "type": "EmbeddedLink",
            "text": "Pay now with Monnify",
            "on-click-action": {
              "name": "open_url",
              "url": "${data.checkout_url}"
            }
          },
          {
            "type": "TextCaption",
            "text": "We verify every payment automatically — no screenshots needed. Your receipt lands in this chat the moment it's confirmed."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
