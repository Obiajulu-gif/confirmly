{
  "//": "Confirmly native WhatsApp ordering Flow. Do NOT edit the generated flows/order-flow.json by hand — edit this template and run `npm run flow:build`, which injects Base64 images in place of the __ASSET_*__ tokens. Flow JSON 7.1 (latest, verified against Meta's changelog) with data_api_version 3.0. Every screen after START is data-driven through the data_exchange endpoint at app/api/whatsapp/flow/route.ts, which resolves every store, product, price and stock value from PostgreSQL and never trusts a value echoed by the client.",
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "START": ["SEARCH"],
    "SEARCH": ["SHOP"],
    "SHOP": ["DELIVERY"],
    "DELIVERY": ["REVIEW"],
    "REVIEW": []
  },
  "screens": [
    {
      "id": "START",
      "title": "Order on WhatsApp",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "__ASSET_BANNER__",
            "height": 200,
            "scale-type": "cover",
            "alt-text": "Confirmly — order from local stores on WhatsApp"
          },
          {
            "type": "TextHeading",
            "text": "What do you want to order?"
          },
          {
            "type": "TextBody",
            "text": "Find a store and check out without leaving WhatsApp. Payments settle securely through Monnify."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "entry_point",
            "label": "Select an option",
            "required": true,
            "media-size": "regular",
            "data-source": [
              {
                "id": "search",
                "title": "Search",
                "description": "Find a store by name or code",
                "image": "__ASSET_ICON_SEARCH__",
                "alt-text": "Search"
              },
              {
                "id": "marketplace",
                "title": "Marketplace",
                "description": "Browse nearby stores",
                "image": "__ASSET_ICON_MARKETPLACE__",
                "alt-text": "Marketplace"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "enabled": "${form.entry_point}",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "entry_point": "${form.entry_point}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SEARCH",
      "title": "Choose a store",
      "terminal": false,
      "data": {
        "search_hint": {
          "type": "string",
          "__example__": "Type a store name or code, then tap Continue."
        },
        "has_stores": { "type": "boolean", "__example__": true },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "store_example",
              "title": "Ada Styles",
              "description": "Fashion · ADASTYLES"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
          },
          {
            "type": "TextBody",
            "text": "${data.search_hint}"
          },
          {
            "type": "TextInput",
            "name": "store_query",
            "label": "Store name or code",
            "input-type": "text",
            "required": false
          },
          {
            "type": "If",
            "condition": "${data.has_stores}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "store_id",
                "label": "Stores",
                "required": false,
                "data-source": "${data.stores}"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "store_query": "${form.store_query}",
                "store_id": "${form.store_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHOP",
      "title": "Shop",
      "terminal": false,
      "data": {
        "store_name": { "type": "string", "__example__": "Ada Styles" },
        "has_cart": { "type": "boolean", "__example__": false },
        "cart_summary": {
          "type": "string",
          "__example__": "Your cart is empty. Pick an item below and choose Add this item."
        },
        "cart_total": { "type": "string", "__example__": "" },
        "has_skus": { "type": "boolean", "__example__": true },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" },
        "skus": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "product_example",
              "title": "Cotton Polo — Black / L",
              "description": "₦12,000 · 8 left"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.store_name}" },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
          },
          {
            "type": "If",
            "condition": "${data.has_cart}",
            "then": [
              { "type": "TextBody", "text": "${data.cart_summary}" },
              { "type": "TextSubheading", "text": "${data.cart_total}" }
            ]
          },
          {
            "type": "If",
            "condition": "${data.has_skus}",
            "then": [
              {
                "type": "Dropdown",
                "name": "sku",
                "label": "Add an item",
                "required": false,
                "data-source": "${data.skus}"
              },
              {
                "type": "Dropdown",
                "name": "quantity",
                "label": "Quantity",
                "required": false,
                "data-source": [
                  { "id": "1", "title": "1" },
                  { "id": "2", "title": "2" },
                  { "id": "3", "title": "3" },
                  { "id": "4", "title": "4" },
                  { "id": "5", "title": "5" },
                  { "id": "6", "title": "6" },
                  { "id": "7", "title": "7" },
                  { "id": "8", "title": "8" },
                  { "id": "9", "title": "9" },
                  { "id": "10", "title": "10" }
                ]
              }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "next_action",
            "label": "What would you like to do?",
            "required": true,
            "data-source": [
              { "id": "add", "title": "Add this item to cart" },
              { "id": "checkout", "title": "Checkout" },
              { "id": "remove", "title": "Remove last item" }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "sku": "${form.sku}",
                "quantity": "${form.quantity}",
                "next_action": "${form.next_action}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DELIVERY",
      "title": "Delivery",
      "terminal": false,
      "data": {
        "has_zones": { "type": "boolean", "__example__": true },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "zone_example", "title": "Lekki", "description": "₦1,500 delivery" },
            { "id": "PICKUP", "title": "Store pickup", "description": "Free" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Where should we deliver?"
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
          },
          {
            "type": "If",
            "condition": "${data.has_zones}",
            "then": [
              {
                "type": "Dropdown",
                "name": "delivery_zone",
                "label": "Delivery area",
                "required": true,
                "data-source": "${data.zones}"
              },
              {
                "type": "TextArea",
                "name": "address",
                "label": "Delivery address",
                "helper-text": "House number, street and landmark. Leave blank for store pickup.",
                "required": false
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "delivery_zone": "${form.delivery_zone}",
                "address": "${form.address}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review order",
      "terminal": true,
      "data": {
        "summary": {
          "type": "string",
          "__example__": "2 × Cotton Polo (M, Black)\nDeliver to Lekki\n12 Admiralty Way"
        },
        "total_label": {
          "type": "string",
          "__example__": "Total: ₦25,500"
        },
        "flow_token": {
          "type": "string",
          "__example__": "flow-token-example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Review your order"
          },
          {
            "type": "TextBody",
            "text": "${data.summary}"
          },
          {
            "type": "TextSubheading",
            "text": "${data.total_label}"
          },
          {
            "type": "TextCaption",
            "text": "Tapping Confirm sends your order to the store. You will get a secure Monnify payment link to complete checkout."
          },
          {
            "type": "Footer",
            "label": "Confirm order",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "flow_token": "${data.flow_token}"
              }
            }
          }
        ]
      }
    }
  ]
}
