{
  "//": "Confirmly native WhatsApp ordering Flow. Do NOT edit the generated flows/order-flow.json by hand — edit this template and run `npm run flow:build`, which injects Base64 images in place of the __ASSET_*__ tokens. Flow JSON 7.1 (latest, verified against Meta's changelog) with data_api_version 3.0. Every screen after START is data-driven through the data_exchange endpoint at app/api/whatsapp/flow/route.ts, which resolves every store, product, price and stock value from PostgreSQL and never trusts a value echoed by the client.",
  "version": "7.1",
  "data_api_version": "3.0",
  "routing_model": {
    "START": ["SEARCH"],
    "SEARCH": ["SHOP"],
    "SHOP": ["DELIVERY"],
    "DELIVERY": ["REVIEW"],
    "REVIEW": []
  },
  "screens": [
    {
      "id": "START",
      "title": "Order on WhatsApp",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "__ASSET_BANNER__",
            "height": 200,
            "scale-type": "cover",
            "alt-text": "Confirmly — order from local stores on WhatsApp"
          },
          {
            "type": "TextHeading",
            "text": "What do you want to order?"
          },
          {
            "type": "TextBody",
            "text": "Find a store and check out without leaving WhatsApp. Payments settle securely through Monnify."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "entry_point",
            "label": "Select an option",
            "required": true,
            "media-size": "regular",
            "data-source": [
              {
                "id": "search",
                "title": "Search",
                "description": "Find a store by name or code",
                "image": "__ASSET_ICON_SEARCH__",
                "alt-text": "Search"
              },
              {
                "id": "marketplace",
                "title": "Marketplace",
                "description": "Browse nearby stores",
                "image": "__ASSET_ICON_MARKETPLACE__",
                "alt-text": "Marketplace"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "enabled": "${form.entry_point}",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "entry_point": "${form.entry_point}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SEARCH",
      "title": "Choose a store",
      "terminal": false,
      "data": {
        "search_hint": {
          "type": "string",
          "__example__": "Type a store name or code, then tap Continue."
        },
        "has_stores": { "type": "boolean", "__example__": true },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" },
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "store_example",
              "title": "Ada Styles",
              "description": "Fashion · ADASTYLES"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
          },
          {
            "type": "TextBody",
            "text": "${data.search_hint}"
          },
          {
            "type": "TextInput",
            "name": "store_query",
            "label": "Store name or code",
            "input-type": "text",
            "required": false
          },
          {
            "type": "If",
            "condition": "${data.has_stores}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "store_id",
                "label": "Stores",
                "required": false,
                "data-source": "${data.stores}"
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "store_query": "${form.store_query}",
                "store_id": "${form.store_id}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "SHOP",
      "title": "Shop",
      "terminal": false,
      "data": {
        "store_name": { "type": "string", "__example__": "Ada Kitchen" },
        "footer_label": { "type": "string", "__example__": "Continue" },
        "show_product": { "type": "boolean", "__example__": false },
        "show_cart": { "type": "boolean", "__example__": false },
        "show_cart_hint": { "type": "boolean", "__example__": false },
        "show_products": { "type": "boolean", "__example__": true },
        "show_product_image": { "type": "boolean", "__example__": false },
        "show_sizes": { "type": "boolean", "__example__": false },
        "show_colours": { "type": "boolean", "__example__": false },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" },
        "has_cart": { "type": "boolean", "__example__": false },
        "cart_hint": { "type": "string", "__example__": "" },
        "has_products": { "type": "boolean", "__example__": true },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" },
              "image": { "type": "string" },
              "alt-text": { "type": "string" }
            }
          },
          "__example__": [
            {
              "id": "product_example",
              "title": "Fried Rice",
              "description": "Main meals · ₦1,150",
              "image": "",
              "alt-text": "Fried Rice"
            }
          ]
        },
        "product_name": { "type": "string", "__example__": "Stew" },
        "product_price": { "type": "string", "__example__": "₦820" },
        "product_description": { "type": "string", "__example__": "Rich tomato stew." },
        "product_image": { "type": "string", "__example__": "" },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "1", "title": "1" },
            { "id": "2", "title": "2" }
          ]
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": []
        },
        "colours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": []
        },
        "cart_lines": { "type": "string", "__example__": "" },
        "cart_total": { "type": "string", "__example__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "${data.store_name}" },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
          },
          {
            "type": "If",
            "condition": "${data.show_cart_hint}",
            "then": [{ "type": "TextBody", "text": "${data.cart_hint}" }]
          },
          {
            "type": "If",
            "condition": "${data.show_products}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "product_pick",
                "label": "Choose a product",
                "required": false,
                "media-size": "regular",
                "data-source": "${data.products}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_product_image}",
            "then": [
              {
                "type": "Image",
                "src": "${data.product_image}",
                "height": 220,
                "scale-type": "cover",
                "alt-text": "${data.product_name}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_product}",
            "then": [
              { "type": "TextHeading", "text": "${data.product_name}" },
              { "type": "TextSubheading", "text": "${data.product_price}" },
              { "type": "TextBody", "text": "${data.product_description}" },
              {
                "type": "Dropdown",
                "name": "quantity",
                "label": "Quantity",
                "required": false,
                "data-source": "${data.quantities}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_sizes}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "size",
                "label": "Size",
                "required": false,
                "data-source": "${data.sizes}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_colours}",
            "then": [
              {
                "type": "RadioButtonsGroup",
                "name": "colour",
                "label": "Colour",
                "required": false,
                "data-source": "${data.colours}"
              }
            ]
          },
          {
            "type": "If",
            "condition": "${data.show_cart}",
            "then": [
              { "type": "TextBody", "text": "${data.cart_lines}" },
              { "type": "TextSubheading", "text": "${data.cart_total}" },
              {
                "type": "RadioButtonsGroup",
                "name": "cart_action",
                "label": "What next?",
                "required": true,
                "data-source": [
                  { "id": "continue", "title": "Continue shopping" },
                  { "id": "checkout", "title": "Checkout" },
                  { "id": "remove", "title": "Remove last item" }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "${data.footer_label}",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "product_pick": "${form.product_pick}",
                "quantity": "${form.quantity}",
                "size": "${form.size}",
                "colour": "${form.colour}",
                "cart_action": "${form.cart_action}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "DELIVERY",
      "title": "Delivery",
      "terminal": false,
      "data": {
        "has_zones": { "type": "boolean", "__example__": true },
        "has_error": { "type": "boolean", "__example__": false },
        "error_message": { "type": "string", "__example__": "" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "zone_example", "title": "Lekki", "description": "₦1,500 delivery" },
            { "id": "PICKUP", "title": "Store pickup", "description": "Free" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Where should we deliver?"
          },
          {
            "type": "If",
            "condition": "${data.has_error}",
            "then": [{ "type": "TextCaption", "text": "${data.error_message}" }]
          },
          {
            "type": "If",
            "condition": "${data.has_zones}",
            "then": [
              {
                "type": "Dropdown",
                "name": "delivery_zone",
                "label": "Delivery area",
                "required": true,
                "data-source": "${data.zones}"
              },
              {
                "type": "TextArea",
                "name": "address",
                "label": "Delivery address",
                "helper-text": "House number, street and landmark. Leave blank for store pickup.",
                "required": false
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continue",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "delivery_zone": "${form.delivery_zone}",
                "address": "${form.address}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "REVIEW",
      "title": "Review order",
      "terminal": true,
      "data": {
        "summary": {
          "type": "string",
          "__example__": "2 × Cotton Polo (M, Black)\nDeliver to Lekki\n12 Admiralty Way"
        },
        "total_label": {
          "type": "string",
          "__example__": "Total: ₦25,500"
        },
        "flow_token": {
          "type": "string",
          "__example__": "flow-token-example"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Review your order"
          },
          {
            "type": "TextBody",
            "text": "${data.summary}"
          },
          {
            "type": "TextSubheading",
            "text": "${data.total_label}"
          },
          {
            "type": "TextCaption",
            "text": "Tapping Confirm sends your order to the store. You will get a secure Monnify payment link to complete checkout."
          },
          {
            "type": "Footer",
            "label": "Confirm order",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "flow_token": "${data.flow_token}"
              }
            }
          }
        ]
      }
    }
  ]
}
