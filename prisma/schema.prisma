generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MerchantUserRole {
  OWNER
  STAFF
}

enum PaymentProfileStatus {
  PENDING_VALIDATION
  VALIDATED
  VALIDATION_FAILED
}

enum SubaccountStatus {
  NOT_CREATED
  ACTIVE
  ACTIVATION_REQUIRED
  FAILED
  REPLACED
}

enum SettlementState {
  PENDING
  SETTLED
  FAILED
}

enum ConversationState {
  NEW
  COLLECTING_ORDER
  NEEDS_CLARIFICATION
  AWAITING_CONFIRMATION
  PAYMENT_PENDING
  PAID
  FULFILLING
  COMPLETED
  CANCELLED
  HUMAN_REQUIRED
  HUMAN_ACTIVE
}

enum AutomationMode {
  AUTO
  HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  INTERACTIVE
  BUTTON_REPLY
  LIST_REPLY
  IMAGE
  DOCUMENT
  TEMPLATE
  STATUS
  UNSUPPORTED
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum OrderState {
  DRAFT
  CONFIRMED
  PAYMENT_PENDING
  PAID
  NEEDS_ATTENTION
  FULFILLING
  COMPLETED
  CANCELLED
}

enum PaymentProvider {
  MONNIFY
  DEMO
}

enum PaymentState {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIALLY_PAID
  OVERPAID
  REVERSED
}

enum WebhookProvider {
  WHATSAPP
  MONNIFY
}

enum WebhookEventState {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum AuditActor {
  SYSTEM
  CUSTOMER
  MERCHANT
  AI
  PROVIDER
}

enum ProductImageSource {
  MERCHANT_UPLOAD
  AI_GENERATED
  EXTERNAL_URL
}

enum ProductImageStatus {
  NONE
  PROCESSING
  READY
  FAILED
}

// --- Multi-branch business / merchant roles --------------------------------

/**
 * v1 roles. MERCHANT = business owner; BRANCH_AGENT = scoped to one branch.
 */
enum BusinessRole {
  MERCHANT
  BRANCH_AGENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

/**
 * Lifecycle of a branch (the Merchant model). `active` mirrors ACTIVE.
 */
enum BranchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum LedgerEntryType {
  PAYMENT_CREDIT
  REFUND_DEBIT
  CHARGEBACK_DEBIT
  WITHDRAWAL_DEBIT
  WITHDRAWAL_REVERSAL
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships          MerchantMembership[]
  resetTokens          PasswordResetToken[]
  businessMemberships  BusinessMembership[]
  invitationsSent      BranchAgentInvitation[] @relation("InvitedBy")
  withdrawalsRequested Withdrawal[]            @relation("RequestedBy")
}

model MerchantMembership {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  role       MerchantUserRole @default(OWNER)
  createdAt  DateTime         @default(now())

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * A Merchant is a BRANCH/store in the multi-branch model. `businessId` groups
 * branches under one owning Business (nullable until backfilled).
 */
model Merchant {
  id           String       @id @default(cuid())
  /**
   * Owning Business (the top-level account). Nullable during rollout.
   */
  businessId   String?
  business     Business?    @relation(fields: [businessId], references: [id], onDelete: SetNull)
  name         String
  slug         String       @unique
  /**
   * WhatsApp store code customers type to select this shop (e.g. ADASTYLES).
   */
  storeCode    String       @unique
  email        String
  category     String?
  description  String?
  supportEmail String?
  logoUrl      String?
  phoneNumber  String?
  address      String?
  stateRegion  String?
  country      String       @default("Nigeria")
  currency     String       @default("NGN")
  /**
   * `active` stays the customer-facing on/off (WhatsApp filters on it).
   */
  active       Boolean      @default(true)
  /**
   * Branch lifecycle; ACTIVE mirrors active=true, SUSPENDED/CLOSED => false.
   */
  status       BranchStatus @default(ACTIVE)
  onboardedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships       MerchantMembership[]
  paymentProfiles   MerchantPaymentProfile[]
  products          Product[]
  deliveryZones     DeliveryZone[]
  customers         Customer[]
  conversations     Conversation[]
  messages          WhatsAppMessage[]
  orders            Order[]
  settlements       Settlement[]
  auditEvents       AuditEvent[]
  branchAssignments BranchAssignment[]
  invitations       BranchAgentInvitation[]
  ledgerEntries     WalletLedgerEntry[]

  @@index([businessId, active])
}

model MerchantPaymentProfile {
  id                  String               @id @default(cuid())
  merchantId          String
  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  bankCode            String
  bankName            String
  /**
   * AES-256-GCM ciphertext — never stored or shown in plaintext.
   */
  accountNumberEnc    String
  accountNumberMasked String
  /**
   * Name resolved by Monnify account enquiry — never free-typed.
   */
  accountName         String?
  validationStatus    PaymentProfileStatus @default(PENDING_VALIDATION)
  subAccountCode      String?              @unique
  subaccountStatus    SubaccountStatus     @default(NOT_CREATED)
  splitPercentage     Int                  @default(100)
  active              Boolean              @default(false)
  lastValidatedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([merchantId, active])
}

/**
 * Maps a WhatsApp user to their currently selected store (one shared
 * business number serves every merchant in the hackathon build).
 */
model WaSession {
  id               String   @id @default(cuid())
  waId             String   @unique
  activeMerchantId String?
  profileName      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/**
 * A native WhatsApp Flow ordering session. The raw flow_token is never stored
 * (only its SHA-256), and the data endpoint validates it before every screen.
 * `state` accumulates the customer's server-resolved selections across screens.
 */
model WhatsAppFlowSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  waId          String
  merchantId    String?
  customerId    String?
  currentScreen String    @default("START")
  state         Json?
  completedAt   DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([waId])
  @@index([expiresAt])
}

model Product {
  id                 String              @id @default(cuid())
  merchantId         String
  merchant           Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  category           String?
  priceKobo          Int
  aliases            String[]            @default([])
  stockQuantity      Int                 @default(0)
  active             Boolean             @default(true)
  imageUrl           String?
  imageSource        ProductImageSource?
  imageStatus        ProductImageStatus  @default(NONE)
  imageAltText       String?
  imagePrompt        String?
  imageGeneratedAt   DateTime?
  imageApprovedAt    DateTime?
  imageFailureReason String?
  imageContentHash   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  variants   ProductVariant[]
  orderItems OrderItem[]
  imageAsset ProductImageAsset?

  @@index([merchantId, active])
}

model ProductImageAsset {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchantId  String
  bytes       Bytes
  contentType String
  sizeBytes   Int
  sha256      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size                String?
  colour              String?
  sku                 String?
  priceAdjustmentKobo Int      @default(0)
  stockQuantity       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([productId, size, colour])
  @@index([productId])
}

model DeliveryZone {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  aliases    String[] @default([])
  feeKobo    Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, name])
  @@index([merchantId, active])
}

model Customer {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  waId           String
  phoneNumber    String
  name           String?
  email          String?
  defaultAddress String?
  optedIn        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversations Conversation[]
  messages      WhatsAppMessage[]
  orders        Order[]

  @@unique([merchantId, waId])
  @@index([merchantId])
}

model Conversation {
  id                String            @id @default(cuid())
  merchantId        String
  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel           String            @default("whatsapp")
  state             ConversationState @default(NEW)
  automationMode    AutomationMode    @default(AUTO)
  draft             Json?
  pendingQuestion   String?
  lastInboundAt     DateTime?
  lastOutboundAt    DateTime?
  /**
   * Set when an abandoned-order nudge was sent — throttles to one per cycle.
   */
  lastNudgeAt       DateTime?
  /**
   * Human takeover attribution (branch-scoped): who holds this chat now.
   */
  takenOverByUserId String?
  takenOverAt       DateTime?
  releasedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  messages    WhatsAppMessage[]
  orders      Order[]
  auditEvents AuditEvent[]

  @@unique([merchantId, customerId, channel])
  @@index([merchantId, state])
}

model WhatsAppMessage {
  id                String           @id @default(cuid())
  providerMessageId String           @unique
  merchantId        String
  merchant          Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversationId    String?
  conversation      Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  direction         MessageDirection
  type              MessageType
  textBody          String?
  payload           Json?
  status            MessageStatus    @default(RECEIVED)
  providerTimestamp DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([merchantId, createdAt])
  @@index([conversationId, createdAt])
}

model Order {
  id              String        @id @default(cuid())
  reference       String        @unique
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  state           OrderState    @default(DRAFT)
  subtotalKobo    Int
  deliveryFeeKobo Int           @default(0)
  discountKobo    Int           @default(0)
  totalKobo       Int
  deliveryMethod  String?
  deliveryAddress String?
  deliveryZone    String?
  notes           String?
  confirmedAt     DateTime?
  paidAt          DateTime?
  fulfilledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items       OrderItem[]
  payment     Payment?
  receipt     Receipt?
  auditEvents AuditEvent[]

  @@index([merchantId, state, createdAt])
  @@index([merchantId, createdAt])
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Immutable snapshots taken at confirmation time.
  productNameSnapshot   String
  unitPriceKoboSnapshot Int
  quantity              Int
  variantSnapshot       String?
  lineTotalKobo         Int

  @@index([orderId])
}

model Payment {
  id                      String          @id @default(cuid())
  orderId                 String          @unique
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                PaymentProvider @default(MONNIFY)
  state                   PaymentState    @default(CREATED)
  invoiceReference        String          @unique
  paymentReference        String?         @unique
  transactionReference    String?         @unique
  attempt                 Int             @default(1)
  expectedAmountKobo      Int
  paidAmountKobo          Int             @default(0)
  method                  String?
  checkoutUrl             String?
  virtualAccount          Json?
  /**
   * Merchant subaccount used at checkout — snapshot, never recomputed.
   */
  subAccountCodeSnapshot  String?
  splitPercentageSnapshot Int?
  /**
   * True when the checkout fell back to the platform default account.
   */
  routedToPlatform        Boolean         @default(false)
  sanitizedResponse       Json?
  verifiedAt              DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  settlement Settlement?

  @@index([state])
}

model Settlement {
  id                String          @id @default(cuid())
  paymentId         String          @unique
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  merchantId        String
  merchant          Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  grossAmountKobo   Int
  feeKobo           Int             @default(0)
  netAmountKobo     Int
  reference         String?         @unique
  state             SettlementState @default(PENDING)
  destinationMasked String?
  settledAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([merchantId, state])
}

model WebhookEvent {
  id               String            @id @default(cuid())
  provider         WebhookProvider
  providerEventKey String            @unique
  eventType        String
  payload          Json
  state            WebhookEventState @default(RECEIVED)
  attempts         Int               @default(0)
  errorSummary     String?
  processedAt      DateTime?
  createdAt        DateTime          @default(now())

  @@index([provider, state, createdAt])
}

model Receipt {
  id        String    @id @default(cuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token     String    @unique
  issuedAt  DateTime  @default(now())
  revokedAt DateTime?
}

model AuditEvent {
  id             String        @id @default(cuid())
  merchantId     String
  merchant       Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  event          String
  actor          AuditActor    @default(SYSTEM)
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([merchantId, createdAt])
  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Multi-branch business, roles, invitations, wallet
// ---------------------------------------------------------------------------

/**
 * Top-level account that owns one or more branches (the Merchant model).
 */
model Business {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  legalName    String?
  supportEmail String?
  supportPhone String?
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   BusinessMembership[]
  branches      Merchant[]
  invitations   BranchAgentInvitation[]
  auditEvents   BusinessAuditEvent[]
  ledgerEntries WalletLedgerEntry[]
  withdrawals   Withdrawal[]
}

/**
 * A user's role within a Business. One row per (business, user).
 */
model BusinessMembership {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  branchAssignments BranchAssignment[]

  @@unique([businessId, userId])
  @@index([userId, status])
}

/**
 * Branch Agent → branch link. v1 enforces one active branch per agent.
 */
model BranchAssignment {
  id           String             @id @default(cuid())
  membershipId String
  membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Merchant           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  active       Boolean            @default(true)
  assignedAt   DateTime           @default(now())
  revokedAt    DateTime?

  @@unique([membershipId, branchId])
  @@index([branchId, active])
}

/**
 * Secure email invitation for a Branch Agent. Token is stored hashed only.
 */
model BranchAgentInvitation {
  id              String           @id @default(cuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Merchant         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  email           String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  invitedBy       User             @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([businessId, status])
  @@index([email])
}

/**
 * Business-level audit trail (branch/agent/payout/withdrawal actions).
 */
model BusinessAuditEvent {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event       String
  actorUserId String?
  branchId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
}

/**
 * Append-only wallet ledger. Amounts are signed integer kobo (credit +/debit −).
 */
model WalletLedgerEntry {
  id           String          @id @default(cuid())
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Merchant?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type         LedgerEntryType
  amountKobo   Int
  paymentId    String?
  withdrawalId String?
  memo         String?
  createdAt    DateTime        @default(now())

  @@unique([type, paymentId])
  @@index([businessId, createdAt])
  @@index([branchId, createdAt])
}

/**
 * Merchant-initiated withdrawal request (no real payout transfer in v1).
 */
model Withdrawal {
  id                String           @id @default(cuid())
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedByUserId String
  requestedBy       User             @relation("RequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  amountKobo        Int
  status            WithdrawalStatus @default(REQUESTED)
  destinationMasked String?
  reference         String           @unique
  failureReason     String?
  createdAt         DateTime         @default(now())
  completedAt       DateTime?
  updatedAt         DateTime         @updatedAt

  @@index([businessId, status])
}
